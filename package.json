{
  "name": "dsh-session-context-menu",
  "version": "0.2.2",
  "description": "Right-click session and workspace actions for the official DeepSeek Harness web profile.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "tests",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-workspace": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    }
  }
}
