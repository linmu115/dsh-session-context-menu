{
  "name": "dsh-session-context-menu",
  "version": "0.3.5-dsh021.1",
  "description": "DSH 0.2 RC2 context-menu enhancement: stable row identity, native pinning and Maintenance actions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-session-context-menu.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.7.0",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "tests",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.12"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    }
  }
}
